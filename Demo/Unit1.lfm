        object CssLabel2: TCssLabel
          Left = 13
          Height = 488
          Top = 41
          Width = 1117
          Align = alClient
          BorderSpacing.Top = 5
          Caption = '<h2>Text styles</h2><p>Normal, <b>bold</b>, <strong>strong</strong>, <i>italic</i>, <em>emphasis</em>, <u>underline</u>, <ins>inserted</ins>, <s>struck</s>, <del>deleted</del>, <code>code</code>, <kbd>kbd</kbd>, <samp>samp</samp>, <tt>tt</tt>, <sup>sup</sup>, <sub>sub</sub>, <q>quoted phrase</q>.</p><h2>Alignment</h2><center>This paragraph is centered.</center><p align="center">Another centered paragraph, via align="center".</p><p style="text-align:right">This one is right-aligned via text-align:right.</p><h2>Lists</h2><ul><li>First unordered item</li><li>Second item with <b>bold</b> text</li><li>Third item with an <a href="https://example.com">inline link</a></li></ul><ol><li>First ordered item</li><li>Second ordered item</li><li>Third ordered item</li></ol><hr><h2>Colors and inline styles</h2><p><span style="color:#16A34A">green span</span>, <span style="color:#2563EB;font-weight:bold">blue bold span</span>, <font color="#DC2626">legacy red font</font>, <span style="font-style:italic">italic span</span>, <span style="text-decoration:underline">underlined span</span>.</p><h2>Links</h2><p>Visit <a href="https://example.com">Example</a>, <a href="https://lazarus.freepascal.org">Lazarus IDE</a>, or <a href="https://www.freepascal.org">Free Pascal</a>. Hover a link to see the color change.</p><div>A block-level <b>container</b> with <i>mixed</i> content.</div>'
          CssTag = 'control'
          HtmlMode = True
          StyleProvider = CssStyleProvider1
          OnLinkClick = CssLabel2LinkClick
          MonospaceFontName = 'Courier New'
          TabOrder = 0
          Alignment = taLeftJustify
          Layout = tlTop
          WordWrap = False
          AutoSize = True
          ShowAccelChar = True
          Transparent = False
        end
