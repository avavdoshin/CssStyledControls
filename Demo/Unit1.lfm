  object CssStyleProvider1: TCssStyleProvider
    DefaultStyleName = 'Light'
    CssText = '@variant light'#13#10'{'#13#10'  .standart-form { background-color: #ffffff; color: #000000; font-family: ''Segoe UI'', ''Segoe UI Variable'', ''Helvetica Neue'', Arial, sans-serif; }'#13#10'  .standart-btn { background: #eeeeee; font-weight: bold; }'#13#10'  .standart-edit { background: #f9f9f9; text-align: left; }'#13#10'}'#13#10#13#10'* {'#13#10'  font-family: ''Segoe UI'', ''Segoe UI Variable'', ''Helvetica Neue'', Arial, sans-serif;'#13#10'  font-size: 10pt;'#13#10'  color: #1E293B;'#13#10'  background-color: #F8FAFC;'#13#10'  border-radius: 6px;'#13#10'  focus-color: #2563EB;'#13#10'}'#13#10#13#10'::hint {'#13#10'  background-color: #F8FAFC;'#13#10'  color: #0F172A;'#13#10'  border: 1px solid #94A3B8;'#13#10'  border-radius: 6px;'#13#10'  padding: 6px 10px;'#13#10'  font-size: 9pt;'#13#10'  text-align: left;'#13#10'  vertical-align: top;'#13#10'}'#13#10#13#10'a { color: #2563EB; text-decoration: underline; cursor: pointer; }'#13#10'a:hover  { color: #1D4ED8; }'#13#10'a:active { color: #1E40AF; }'#13#10#13#10'TCssButton {'#13#10'  background-color: #F1F5F9;'#13#10'  color: #1E293B;'#13#10'  border: 1px solid #CBD5E1;'#13#10'  border-radius: 6px;'#13#10'  padding: 2px 8px;'#13#10'  text-align: center;'#13#10'  vertical-align: middle;'#13#10'  font-weight: 500;'#13#10'  cursor: pointer;'#13#10'}'#13#10'TCssButton:hover  { background-color: #E2E8F0; border-color: #94A3B8; }'#13#10'TCssButton:active { background-color: #CBD5E1; border-color: #94A3B8; }'#13#10'TCssButton:focus  { border-color: #93C5FD; }'#13#10'TCssButton:disabled {'#13#10'  background-color: #F8FAFC;'#13#10'  border-color: #E2E8F0;'#13#10'  color: #CBD5E1;'#13#10'  cursor: default;'#13#10'}'#13#10'TCssButton:cancel {'#13#10'  background-color: #FEF2F2;'#13#10'  color: #B91C1C;'#13#10'  border: 1px solid #FCA5A5;'#13#10'}'#13#10'TCssButton:cancel:hover  { background-color: #FEE2E2; border-color: #F87171; }'#13#10'TCssButton:cancel:active { background-color: #FECACA; border-color: #EF4444; }'#13#10'TCssButton:cancel:focus  { border-color: #FCA5A5; }'#13#10'TCssButton:cancel:disabled {'#13#10'  background-color: #FEF2F2;'#13#10'  border-color: #FEE2E2;'#13#10'  color: #FECACA;'#13#10'}'#13#10'TCssButton:default {'#13#10'  background-color: #2563EB;'#13#10'  color: #FFFFFF;'#13#10'  border: 1px solid #2563EB;'#13#10'}'#13#10'TCssButton:default:hover  { background-color: #1D4ED8; border-color: #1D4ED8; }'#13#10'TCssButton:default:active { background-color: #1E40AF; border-color: #1E40AF; }'#13#10'TCssButton:default:focus  { border-color: #93C5FD; }'#13#10'TCssButton:default:disabled {'#13#10'  background-color: #F1F5F9;'#13#10'  border-color: #E2E8F0;'#13#10'  color: #94A3B8;'#13#10'}'#13#10#13#10'TCssCheckBox {'#13#10'  background-color: transparent;'#13#10'  color: #1E293B;'#13#10'  border: none;'#13#10'  border-radius: 0px;'#13#10'  padding: 2px 4px;'#13#10'  text-align: left;'#13#10'  vertical-align: middle;'#13#10'  cursor: pointer;'#13#10'  checkbox-background: #FFFFFF;'#13#10'  checkbox-border-color: #CBD5E1;'#13#10'  checkbox-border-width: 1px;'#13#10'  checkbox-radius: 4px;'#13#10'  check-color: #FFFFFF;'#13#10'}'#13#10'TCssCheckBox:hover          { checkbox-border-color: #2563EB; }'#13#10'TCssCheckBox:checked        { checkbox-background: #2563EB; checkbox-border-color: #2563EB; check-color: #FFFFFF; }'#13#10'TCssCheckBox:checked:hover  { checkbox-background: #1D4ED8; checkbox-border-color: #1D4ED8; }'#13#10'TCssCheckBox:disabled {'#13#10'  color: #94A3B8;'#13#10'  checkbox-background: #F1F5F9;'#13#10'  checkbox-border-color: #E2E8F0;'#13#10'  check-color: #94A3B8;'#13#10'}'#13#10'TCssCheckBox:focus { checkbox-border-color: #93C5FD; }'#13#10#13#10'TCssRadioButton {'#13#10'  background-color: transparent;'#13#10'  color: #1E293B;'#13#10'  border: none;'#13#10'  border-radius: 0px;'#13#10'  padding: 2px 4px;'#13#10'  text-align: left;'#13#10'  vertical-align: middle;'#13#10'  cursor: pointer;'#13#10'  radio-background: #FFFFFF;'#13#10'  radio-border-color: #CBD5E1;'#13#10'  radio-border-width: 1px;'#13#10'  radio-radius: 3px;'#13#10'  dot-color: #2563EB;'#13#10'}'#13#10'TCssRadioButton:hover          { radio-border-color: #2563EB; }'#13#10'TCssRadioButton:checked        { radio-background: #2563EB; radio-border-color: #2563EB; dot-color: #2563EB; }'#13#10'TCssRadioButton:checked:hover  { radio-background: #1D4ED8; radio-border-color: #1D4ED8; dot-color: #1D4ED8; }'#13#10'TCssRadioButton:disabled {'#13#10'  color: #94A3B8;'#13#10'  radio-background: #F1F5F9;'#13#10'  radio-border-color: #E2E8F0;'#13#10'  dot-color: #94A3B8;'#13#10'}'#13#10'TCssRadioButton:focus { radio-border-color: #93C5FD; }'#13#10#13#10'.checkbox {'#13#10'  background-color: #FFFFFF;'#13#10'}'#13#10'.radio {'#13#10'  background-color: #FFFFFF;'#13#10'}'#13#10#13#10'/* Optional Windows 11-style switches. Opt in by adding the `toggle` class.'#13#10'   For groups set CheckBoxCssClass / RadioCssClass to `toggle`. */'#13#10'/* Light: toggle */'#13#10'TCssCheckBox.toggle,'#13#10'checkbox.toggle {'#13#10'  checkbox-style: toggle;'#13#10'  toggle-width: 40px;'#13#10'  toggle-height: 20px;'#13#10'  padding: 0px;'#13#10'  checkbox-background: #F1F5F9;'#13#10'  checkbox-border-color: #CBD5E1;'#13#10'  checkbox-border-width: 1px;'#13#10'  toggle-thumb-color: #64748B;'#13#10'}'#13#10'TCssCheckBox.toggle:hover,'#13#10'checkbox.toggle:hover {'#13#10'  checkbox-background: #E2E8F0;'#13#10'  checkbox-border-color: #94A3B8;'#13#10'}'#13#10'TCssCheckBox.toggle:checked,'#13#10'checkbox.toggle:checked {'#13#10'  checkbox-background: #2563EB;'#13#10'  checkbox-border-color: #2563EB;'#13#10'  toggle-thumb-color: #FFFFFF;'#13#10'}'#13#10'TCssCheckBox.toggle:checked:hover,'#13#10'checkbox.toggle:checked:hover {'#13#10'  checkbox-background: #1D4ED8;'#13#10'  checkbox-border-color: #1D4ED8;'#13#10'}'#13#10'TCssCheckBox.toggle:disabled,'#13#10'checkbox.toggle:disabled {'#13#10'  checkbox-background: #F1F5F9;'#13#10'  checkbox-border-color: #E2E8F0;'#13#10'  toggle-thumb-color: #94A3B8;'#13#10'}'#13#10'TCssCheckBox.toggle:checked:disabled,'#13#10'checkbox.toggle:checked:disabled {'#13#10'  checkbox-background: #BFDBFE;'#13#10'  checkbox-border-color: #BFDBFE;'#13#10'  toggle-thumb-color: #F8FAFC;'#13#10'}'#13#10'TCssCheckBox.toggle:focus,'#13#10'checkbox.toggle:focus {'#13#10'  checkbox-border-color: #93C5FD;'#13#10'}'#13#10#13#10'TCssRadioButton.toggle,'#13#10'radio.toggle {'#13#10'  radio-style: toggle;'#13#10'  toggle-width: 40px;'#13#10'  toggle-height: 20px;'#13#10'  padding: 0px;'#13#10'  radio-background: #F1F5F9;'#13#10'  radio-border-color: #CBD5E1;'#13#10'  radio-border-width: 1px;'#13#10'  toggle-thumb-color: #64748B;'#13#10'}'#13#10'TCssRadioButton.toggle:hover,'#13#10'radio.toggle:hover {'#13#10'  radio-background: #E2E8F0;'#13#10'  radio-border-color: #94A3B8;'#13#10'}'#13#10'TCssRadioButton.toggle:checked,'#13#10'radio.toggle:checked {'#13#10'  radio-background: #2563EB;'#13#10'  radio-border-color: #2563EB;'#13#10'  toggle-thumb-color: #FFFFFF;'#13#10'}'#13#10'TCssRadioButton.toggle:checked:hover,'#13#10'radio.toggle:checked:hover {'#13#10'  radio-background: #1D4ED8;'#13#10'  radio-border-color: #1D4ED8;'#13#10'}'#13#10'TCssRadioButton.toggle:disabled,'#13#10'radio.toggle:disabled {'#13#10'  radio-background: #F1F5F9;'#13#10'  radio-border-color: #E2E8F0;'#13#10'  toggle-thumb-color: #94A3B8;'#13#10'}'#13#10'TCssRadioButton.toggle:checked:disabled,'#13#10'radio.toggle:checked:disabled {'#13#10'  radio-background: #BFDBFE;'#13#10'  radio-border-color: #BFDBFE;'#13#10'  toggle-thumb-color: #F8FAFC;'#13#10'}'#13#10'TCssRadioButton.toggle:focus,'#13#10'radio.toggle:focus {'#13#10'  radio-border-color: #93C5FD;'#13#10'}'#13#10#13#10'TCssCheckGroup,'#13#10'TCssRadioGroup {'#13#10'  background-color: #FFFFFF;'#13#10'  color: #1E293B;'#13#10'  border: 1px solid #E2E8F0;'#13#10'  border-radius: 8px;'#13#10'  padding: 12px;'#13#10'  text-align: left;'#13#10'  vertical-align: top;'#13#10'  focus-within: true;'#13#10