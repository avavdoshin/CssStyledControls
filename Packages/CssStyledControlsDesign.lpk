<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="CssStyledControlsDesign"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="(c) 2026 Alexander V Avdoshin (a.avdoshin@gmail.com)"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\Source"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="CSS-styled visual controls Design-time packages"/>
    <Version Minor="1"/>
    <Files>
      <Item>
        <Filename Value="CssStyledControlDesign.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="CssStyledControlDesign"/>
      </Item>
      <Item>
        <Filename Value="CssMenuReg.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="CssMenuReg"/>
      </Item>
      <Item>
        <Filename Value="..\Source\CssMenuDesigner.pas"/>
        <UnitName Value="CssMenuDesigner"/>
      </Item>
      <Item>
        <Filename Value="CssVirtualTreeColumnsEditor.pas"/>
        <UnitName Value="CssVirtualTreeColumnsEditor"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="IDEIntf"/>
      </Item>
      <Item>
        <PackageName Value="CssStyledControls"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
